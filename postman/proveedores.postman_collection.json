		{
			"name": "Listar",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response is successful\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Validate response structure",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"data\").that.is.an(\"array\");",
							"    pm.expect(jsonData).to.have.property(\"totalRows\").that.is.a(\"number\");",
							"    pm.expect(jsonData).to.have.property(\"totalPages\").that.is.a(\"number\");",
							"});",
							"",
							"// Validate totalRows and totalPages",
							"pm.test(\"Total rows and pages are correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.length).to.eql(jsonData.totalRows);",
							"    pm.expect(jsonData.totalPages).to.be.greaterThan(0);",
							"});",
							"",
							"// Validate each entry in the \"data\" array",
							"pm.test(\"Each provider entry is valid\", function () {",
							"    var jsonData = pm.response.json();",
							"    var uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"",
							"    jsonData.data.forEach(provider => {",
							"        pm.expect(provider).to.have.property(\"id\").that.is.a(\"string\");",
							"        pm.expect(provider.id).to.match(uuidRegex);",
							"",
							"        pm.expect(provider).to.have.property(\"correo\").that.is.a(\"string\");",
							"        pm.expect(provider).to.have.property(\"tipo_identificacion\").that.is.a(\"string\");",
							"        pm.expect(provider).to.have.property(\"identificacion\").that.is.a(\"string\");",
							"        pm.expect(provider).to.have.property(\"pais\").that.is.a(\"string\");",
							"        pm.expect(provider).to.have.property(\"fecha_creacion\").that.is.a(\"string\");",
							"        pm.expect(provider).to.have.property(\"nombre\").that.is.a(\"string\");",
							"        pm.expect(provider).to.have.property(\"direccion\").that.is.a(\"string\");",
							"        pm.expect(provider).to.have.property(\"ciudad\").that.is.a(\"string\");",
							"    });",
							"});",
							"",
							"",
							"// Store the first provider's ID in a local variable",
							"if (pm.response.json().data.length > 0) {",
							"    let firstProviderId = pm.response.json().data[0].id;",
							"    pm.environment.set(\"proveedorId\", firstProviderId);",
							"",
							"    pm.test(\"First provider ID stored in variable\", function () {",
							"        pm.expect(firstProviderId).to.be.a(\"string\");",
							"    });",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
